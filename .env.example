NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: pegue em Project Settings -> API do dashboard Supabase
# Necessária para criar alunos via UI admin e usar a API de OCR
SUPABASE_SERVICE_ROLE_KEY=

# OCR (opcional, mas obrigatório para PDFs escaneados)
# Pegue em https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# URL base do app (usada em emails de convite e callbacks de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
